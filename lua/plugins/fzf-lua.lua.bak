return {
  'ibhagwan/fzf-lua',
  -- optional for icon support
  dependencies = { 'nvim-mini/mini.icons' },
  ---@diagnostic disable: missing-fields
  opts = function()
    local winopts = {
      border = 'single',
      preview = {
        hidden = true
      }
    }

    ---@type fzf-lua.Config|{}
    return {
      winopts = winopts
    }
  end
  ---@diagnostic enable: missing-fields
}
